{
  "cli": {
    "version": ">= 18.12.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true
    },
    "store-preview": {
      "distribution": "internal",
      "channel": "store-preview",
      "env": {
        "APP_VARIANT": "store",
        "EXPO_PUBLIC_SAAS_ZONE": "store.devbyspark.com",
        "EXPO_PUBLIC_AUTH_HUB_API": "https://auth.devbyspark.com/api",
        "EXPO_PUBLIC_PRIVACY_URL": "https://auth.devbyspark.com/privacy-policy/",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "binh.vx@cici21chualang.vn",
        "STORE_APP_NAME": "Spark Store",
        "STORE_APP_VERSION": "1.0.0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "store-production": {
      "autoIncrement": true,
      "channel": "store-production",
      "env": {
        "APP_VARIANT": "store",
        "EXPO_PUBLIC_SAAS_ZONE": "store.devbyspark.com",
        "EXPO_PUBLIC_AUTH_HUB_API": "https://auth.devbyspark.com/api",
        "EXPO_PUBLIC_PRIVACY_URL": "https://auth.devbyspark.com/privacy-policy/",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "binh.vx@cici21chualang.vn",
        "STORE_APP_NAME": "Spark Store",
        "STORE_APP_VERSION": "1.0.0"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "ios": {
        "ascAppId": "6783600148"
      }
    },
    "store-production": {
      "ios": {
        "ascAppId": "6818444586",
        "appleTeamId": "FVS6S6U8V4"
      }
    }
  }
}
